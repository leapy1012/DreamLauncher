<resources>

    <style name="HomeSettings.Theme"
            parent="@style/OplusSupportAppNoTitleTheme.PreferenceFragment.LauncherSettings">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/coloros_surface_page</item>
        <item name="android:windowBackground">@color/coloros_surface_page</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">@bool/home_settings_light_status_bar</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:homeAsUpIndicator">@drawable/coui_back_arrow</item>
        <item name="homeAsUpIndicator">@drawable/coui_back_arrow</item>
        <item name="toolbarStyle">@style/HomeSettings.Toolbar</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.COUI.Toolbar.Button.Navigation</item>
        <item name="couiSwitchStyle">@style/COUISwitchStyle.Light</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.COUITheme.FullScreen.OnlyTitleBar</item>
    </style>

    <!-- Legacy collapsing-toolbar styles still referenced by layout-v31 resources. -->
    <style name="HomeSettings.CollapsingToolbar" parent="@style/Theme.COUI.Green">
        <item name="colorPrimary">@color/coloros_surface_toolbar</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="HomeSettings.CollapsedToolbarTitle"
            parent="@android:style/TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="HomeSettings.ExpandedToolbarTitle" parent="HomeSettings.CollapsedToolbarTitle">
        <item name="android:textSize">32sp</item>
    </style>

</resources>