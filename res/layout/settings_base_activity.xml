<?xml version="1.0" encoding="utf-8"?>
<!-- Same COUI DividerAppBar host as settings_activity (MtkSettings pattern). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coloros_surface_page"
    android:clipToPadding="true"
    android:fitsSystemWindows="false">

    <com.coui.appcompat.toolbar.COUIToolbar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/preference_header_height"
        android:clipChildren="true"
        android:clipToPadding="true" />

    <include layout="@layout/common_divider_appbar_layout" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
