<?xml version="1.0" encoding="utf-8"?>
<!--
  Use wrap_content heights only. The previous ConstraintLayout used height=0dp
  (match_constraint) on the main menu with only a bottom constraint, plus an
  INVISIBLE effect gallery stretched top↔bottom. That deferred a real height
  until a later layout pass; with DragLayer gravity=BOTTOM the bar jumped into
  place — looking like the toggle icons "repositioned" at the end of the enter
  animation.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/overview_panel_main_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="top"
        android:orientation="horizontal"
        android:minHeight="104dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="@dimen/overview_panel_main_menu_padding_top"
        android:paddingBottom="16dp">

        <!-- Oppo togglebar_bar_main order: Widgets, Wallpapers & style, Layout, Home screen settings -->
        <com.android.launcher3.screenedit.IconTextView
            android:id="@+id/widget_button"
            style="@style/PannelButton"
            android:drawableTop="@drawable/quickactionbar_add_widget_icon"
            android:text="@string/widget_button_text" />

        <com.android.launcher3.screenedit.IconTextView
            android:id="@+id/wallpaper_button"
            style="@style/PannelButton"
            android:drawableTop="@drawable/quickactionbar_wallpaper_icon"
            android:text="@string/styles_wallpaper_button_text" />

        <com.android.launcher3.screenedit.IconTextView
            android:id="@+id/layout_button"
            style="@style/PannelButton"
            android:drawableTop="@drawable/quickactionbar_layout_icon"
            android:text="@string/launcher_layout" />

        <com.android.launcher3.screenedit.IconTextView
            android:id="@+id/settings_button"
            style="@style/PannelButton"
            android:drawableTop="@drawable/quickactionbar_launcher_setting_icon"
            android:text="@string/settings_button_text" />
    </LinearLayout>

    <com.android.launcher3.screenedit.GridGallery
        android:id="@+id/effect_gallery"
        style="@style/GridGallery"
        android:layout_width="match_parent"
        android:layout_height="@dimen/transition_effect_panel_height"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone" />
</FrameLayout>
