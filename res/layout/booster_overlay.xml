<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/booster_anim_root"
        android:layout_width="237.5dp"
        android:layout_height="237.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="160dp">

        <View
            android:id="@+id/booster_rocket"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/booster_rocket_orb" />

        <com.android.launcher3.big.booster.DiffuseRingsView
            android:id="@+id/booster_diffuse"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/booster_finish"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:rotationY="-90"
            android:scaleType="centerInside"
            android:src="@drawable/booster_check_circle"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/booster_info_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="420dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/booster_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/booster_phone_boost"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/booster_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/memory_clean_running_animator"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/booster_result_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="280dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/booster_check_circle" />

        <TextView
            android:id="@+id/booster_result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/booster_optimized"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/booster_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:padding="12dp"
        android:src="@drawable/booster_close"
        android:contentDescription="@string/accessibility_close" />
</merge>
