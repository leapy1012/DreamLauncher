<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coloros_surface_card" />
            <stroke
                android:width="@dimen/coloros_card_selected_stroke"
                android:color="@color/coloros_accent" />
            <corners android:radius="@dimen/coloros_card_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coloros_surface_pressed" />
            <corners android:radius="@dimen/coloros_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coloros_surface_card" />
            <corners android:radius="@dimen/coloros_card_radius" />
        </shape>
    </item>
</selector>
