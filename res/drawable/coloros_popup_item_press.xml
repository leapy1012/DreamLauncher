<?xml version="1.0" encoding="utf-8"?>
<!-- Oppo oplus_shortcut_background_click_color as a drawable selector (reliable pressed fill). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_color_card_pressed" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_color_press" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_transparence" />
        </shape>
    </item>
</selector>
