<?xml version="1.0" encoding="utf-8"?>
<!-- Dark popup surface: white-alpha press. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_color_card_pressed_dark" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_color_press_background_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/coui_transparence" />
        </shape>
    </item>
</selector>
