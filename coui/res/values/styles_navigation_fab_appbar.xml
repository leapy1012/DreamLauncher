<?xml version="1.0" encoding="utf-8"?>
<resources>
<style name="Widget.COUI.COUINavigationView" parent="@android:style/Widget">
        <item name="couiBottomToolNavigationItemBg">@drawable/coui_bottom_tool_navigation_item_bg</item>
        <item name="couiBottomToolNavigationItemSelector">@color/coui_bottom_tool_navigation_item_selector</item>
        <item name="couiNaviBackground">@drawable/coui_bottom_tool_navigation_item_bg</item>
        <item name="couiNaviIconTint">@color/coui_bottom_tool_navigation_item_selector</item>
        <item name="couiNaviTextColor">@color/coui_bottom_tool_navigation_item_selector</item>
        <!-- OPPO: tab type uses coui_tab_navigation_view_bg 9-patch (not tool-item ripple). -->
        <item name="couiTabNavigationViewBg">@drawable/coui_tab_navigation_view_bg</item>
        <item name="couiToolNavigationViewBg">@drawable/coui_tab_navigation_view_bg</item>
        <!-- Must be @null: any non-null style makes Material enable the light-blue selected pill. -->
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
<style name="Widget.COUI.COUINavigationView.Dark" parent="@style/Widget.COUI.COUINavigationView">
        <item name="couiNaviBackground">@drawable/coui_bottom_tool_navigation_item_bg_dark</item>
        <item name="couiTabNavigationViewBg">@drawable/coui_tab_navigation_view_bg_dark</item>
        <item name="couiToolNavigationViewBg">@drawable/coui_tab_navigation_view_bg_dark</item>
    </style>
<style name="FloatingButton.Icon" parent="@android:style/Widget">
        <item name="fabNeedElevation">false</item>
        <item name="fabNeedVibrate">true</item>
        <item name="fabScaleAnimation">false</item>
    </style>
<style name="FloatingButton.Icon.Medium" parent="@style/FloatingButton.Icon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="fabButtonSize">64dp</item>
    </style>
<style name="FloatingButton.Icon.Medium.Main" parent="@style/FloatingButton.Icon.Medium">
        <item name="mainFloatingButtonBackgroundColor">@color/coui_floating_button_main_button_color_selector</item>
    </style>
<style name="FloatingButton.Icon.Medium.Secondary" parent="@style/FloatingButton.Icon.Medium">
        <item name="fabTranslateEnhancementRatio">3</item>
        <item name="mainFloatingButtonBackgroundColor">@color/coui_floating_button_secondary_button_color_selector</item>
    </style>
<style name="FloatingButton.Icon.Small" parent="@style/FloatingButton.Icon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="fabButtonSize">56dp</item>
    </style>
<style name="FloatingButton.Icon.Small.Main" parent="@style/FloatingButton.Icon.Small">
        <item name="mainFloatingButtonBackgroundColor">@color/coui_floating_button_main_button_color_selector</item>
    </style>
</resources>

