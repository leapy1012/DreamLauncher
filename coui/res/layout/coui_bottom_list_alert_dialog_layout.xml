<?xml version="1.0" encoding="utf-8"?><!-- Leapy modified 2026-09-08: List dialog layout — contentPanel/listPanel use
     height 0dp + weight so the ListView is constrained between title and
     button bar (fixes scroll-behind Language title/Cancel). Button/custom
     panels keep wrap_content with no weight. -->
<com.coui.appcompat.dialog.widget.COUIAlertDialogMaxLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:coui="http://schemas.android.com/apk/res-auto"
    android:id="@id/parentPanel"
    style="@style/COUIAlertDialogLayoutStyle">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@id/rootView"
        android:clipChildren="true"
        android:clipToPadding="true"
        style="@style/COUIAlertDialogClipCornerLayoutStyle">

        <LinearLayout
            android:id="@id/topPanel"
            style="@style/COUIAlertDialogTopPanelStyle">

            <LinearLayout
                android:id="@id/title_template"
                style="@style/COUIAlertDialogTitleTemplateStyle">

                <ImageView
                    android:id="@android:id/icon"
                    style="@style/COUIAlertDialogIconStyle" />

                <com.coui.appcompat.statement.COUIMaxHeightScrollView
                    android:id="@id/alert_title_scroll_view"
                    style="@style/COUIAlertDialogTitleScrollViewStyle">

                    <com.coui.appcompat.dialog.widget.COUIDialogTitle
                        android:id="@id/alertTitle"
                        android:ellipsize="end"
                        android:maxLines="5"
                        style="@style/COUIAlertDialogTitleStyle" />
                </com.coui.appcompat.statement.COUIMaxHeightScrollView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@id/contentPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:orientation="vertical"
            style="@style/COUIAlertDialogContentPanelStyle">

            <com.coui.appcompat.dialog.widget.COUIMaxHeightNestedScrollView
                android:id="@id/scrollView"
                coui:scrollViewMaxHeight="@dimen/coui_alert_dialog_builder_content_max_height"
                style="@style/COUIAlertDialogMessageScrollViewStyle">

                <com.coui.appcompat.dialog.widget.COUIAlertDialogMessageView
                    android:id="@android:id/message"
                    style="@style/COUIAlertDialogMessageStyle" />
            </com.coui.appcompat.dialog.widget.COUIMaxHeightNestedScrollView>

            <LinearLayout
                android:id="@id/listPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/coui_list_dialog_list_panel_margin_top"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:orientation="vertical" />
        </LinearLayout>

        <FrameLayout
            android:id="@id/customPanel"
            style="@style/COUIAlertDialogCustomPanelStyle">

            <FrameLayout
                android:id="@id/custom"
                style="@style/COUIAlertDialogCustomStyle" />
        </FrameLayout>

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/coui_center_alert_dialog_button_panel" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.coui.appcompat.dialog.widget.COUIAlertDialogMaxLinearLayout>
