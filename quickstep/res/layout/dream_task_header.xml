<?xml version="1.0" encoding="utf-8"?>
<com.dream.quickstep.views.DreamTaskHeaderView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dream_task_header"
    android:layout_width="match_parent"
    android:layout_height="@dimen/color_task_header_view_menu_size"
    android:layout_marginTop="@dimen/dream_task_header_margin_top"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.android.quickstep.views.IconView
        android:id="@+id/icon"
        android:layout_width="@dimen/color_task_header_view_icon_size"
        android:layout_height="@dimen/color_task_header_view_icon_size"
        android:layout_marginStart="@dimen/color_task_header_view_icon_padding_start"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/color_task_header_title_view_margin_start"
        android:layout_toEndOf="@id/icon"
        android:layout_centerVertical="true"
        android:maxWidth="160dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:textColor="#ffffff"
        android:textSize="@dimen/color_task_header_view_text_size"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/menu_button"
        android:layout_width="@dimen/color_task_header_view_menu_size"
        android:layout_height="@dimen/color_task_header_view_menu_size"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:scaleType="center"
        android:src="@drawable/ic_task_menu"
        android:tint="#ffffff" />
</com.dream.quickstep.views.DreamTaskHeaderView>
