<resources>
    
    <!-- hxy-feature: add launcher style function  202312 -->
    <style name="TextAppearance.TileTitle" parent="@*android:style/TextAppearance.DeviceDefault.Subhead"/>
    <style name="TextAppearance.Small" parent="@android:style/TextAppearance.DeviceDefault.Small"/>
    <!-- hxy-feature: add launcher style function  202312 -->

    <!-- add for all apps bg transparent icon -->
    <style name="TransBgAppIcon" parent="BaseIcon.Workspace">
        <item name="android:textColor">?attr/workspaceTextColor</item>
        <item name="android:textSize">@dimen/drop_target_text_size</item>
    </style>

    <style name="PannelButton">
        <item name="android:textSize">@dimen/toggle_bar_item_text_size</item>
        <item name="android:textColor">?attr/workspaceTextColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:drawablePadding">@dimen/togglebar_main_ui_list_item_title_margin_top</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="iconSizePx">@dimen/launcher_toggle_bar_main_ui_item_width</item>
    </style>

    <style name="GridGallery">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="hxyStyle" >
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:actionBarSize">@dimen/density_48dp</item>
        <item name="android:statusBarColor">@color/n_actionbar_bg</item>
    </style>

    <style name="Preference.Category.Prize">
        <item name="android:layout">@layout/prize_preference_category_material_settings</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.Prize">
        <item name="android:widgetLayout">@layout/prize_preference_arrow</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.Prize.Home">
        <item name="android:layout">@layout/prize_preference_home</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.Prize.Switch" parent="@style/Preference.COUI.SwitchPreference">
        <item name="android:layout">@layout/coui_preference</item>
        <item name="android:widgetLayout">@layout/coui_preference_widget_switch</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="SettingsPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceFragmentCompatStyle">@style/HomeSettings.FragmentCompatStyle</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.Prize</item>
        <item name="preferenceStyle">@style/Preference.Prize.Home</item>
        <item name="switchPreferenceStyle">@style/Preference.COUI.SwitchPreference</item>
    </style>

    <!-- ColorOS overview Close pill (replaces Clear all + RAM row). -->
    <style name="OverviewCloseButton"
        parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/hxy_overview_close_pill_bg</item>
        <item name="android:minWidth">@dimen/overview_close_button_width</item>
        <item name="android:minHeight">@dimen/overview_close_button_height</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
</resources>
