<resources>
    
    <!-- hxy-feature: add launcher style function  202312 -->
    <style name="TextAppearance.TileTitle" parent="@*android:style/TextAppearance.DeviceDefault.Subhead"/>
    <style name="TextAppearance.Small" parent="@android:style/TextAppearance.DeviceDefault.Small"/>
    <!-- hxy-feature: add launcher style function  202312 -->

    <!-- add for all apps bg transparent icon -->
    <style name="TransBgAppIcon" parent="BaseIcon.Workspace">
        <item name="android:textColor">?attr/workspaceTextColor</item>
        <item name="android:textSize">@dimen/drop_target_text_size</item>
    </style>

    <style name="PannelButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:layout_gravity">center_vertical|clip_horizontal</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:maxLines">2</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="iconSizePx">@dimen/coloros_edit_action_size</item>
    </style>

    <style name="ColorOsEditAction">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="GridGallery">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="hxyStyle" >
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:actionBarSize">@dimen/density_48dp</item>
        <item name="android:statusBarColor">@color/n_actionbar_bg</item>
    </style>

    <style name="Preference.Category.Prize">
        <item name="android:layout">@layout/prize_preference_category_material_settings</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.Prize">
        <item name="android:widgetLayout">@layout/prize_preference_arrow</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.Prize.Home">
        <item name="android:layout">@layout/prize_preference_home</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.Prize.Switch" parent="@style/Preference.SwitchPreference">
        <item name="android:layout">@layout/prize_switch_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="SettingsPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceFragmentCompatStyle">@style/HomeSettings.FragmentCompatStyle</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.Prize</item>
        <item name="preferenceStyle">@style/Preference.Prize.Home</item>
        <item name="switchPreferenceStyle">@style/Preference.Prize.Switch</item>
    </style>
</resources>
