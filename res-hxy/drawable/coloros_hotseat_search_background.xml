<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D202020" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
            <corners android:radius="@dimen/coloros_hotseat_search_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33202020" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <corners android:radius="@dimen/coloros_hotseat_search_corner_radius" />
        </shape>
    </item>
</selector>
