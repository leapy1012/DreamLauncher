<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/coloros_space_xxlarge"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center">

    <ImageView
        android:id="@+id/imageview"
        android:layout_width="@dimen/coloros_icon_preview_size"
        android:layout_height="@dimen/coloros_icon_preview_size"
        android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/coloros_icon_label_offset"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:maxEms="5"
        android:maxLines="1"
        android:paddingStart="@dimen/coloros_space_micro"
        android:paddingEnd="@dimen/coloros_space_micro"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/coloros_text_primary"
        android:textSize="@dimen/coloros_text_size_caption" />
</RelativeLayout>
