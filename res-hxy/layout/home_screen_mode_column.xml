<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@id/home_screen_mode_preview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_launcher_mode_preview_height"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:forceDarkAllowed="false"
        android:scaleType="fitCenter"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:id="@id/home_screen_mode_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coloros_space_xxlarge"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/coloros_text_tertiary"
        android:textSize="@dimen/coloros_home_screen_mode_title_size" />

    <RadioButton
        android:id="@id/home_screen_mode_radio"
        style="@style/Widget.COUI.CompoundButton.RadioButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/coloros_space_small"
        android:background="@null"
        android:button="@drawable/coui_btn_radio"
        android:buttonTint="@null"
        android:clickable="false"
        android:focusable="false"
        android:minWidth="24dp"
        android:minHeight="24dp" />
</LinearLayout>
