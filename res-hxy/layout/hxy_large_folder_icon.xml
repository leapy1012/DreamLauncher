<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.folder.large.HxyLargeFolderIcon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:focusable="true"
    android:orientation="vertical">

    <com.android.launcher3.folder.large.listview.HxyLargeFolderListView
        android:id="@+id/folder_icon_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:max_row="3"
        app:orientation="2"
        app:span_count="3"
        app:horizontal_space="@dimen/hxy_large_folder_horizontal_space_4x6"
        app:vertical_space="@dimen/hxy_large_folder_vertical_space_4x6" />

    <com.android.launcher3.big.HxyBubbleTextView
        android:id="@+id/folder_icon_name"
        style="@style/BaseIcon.Workspace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:focusable="false" />
</com.android.launcher3.folder.large.HxyLargeFolderIcon>