<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.folder.large.HxyLargeFolderIcon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:orientation="vertical">

    <com.android.launcher3.folder.large.listview.HxyLargeFolderListView
        android:id="@+id/folder_icon_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:max_row="2"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:orientation="2"
        app:span_count="2"
        app:horizontal_space="@dimen/hxy_large_folder_horizontal_space_4x6"
        app:vertical_space="@dimen/hxy_large_folder_vertical_space_4x6" />

    <com.android.launcher3.folder.large.listview.HxyLargeFolderListView
        android:id="@+id/folder_icon_content_next"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:max_row="2"
        app:orientation="2"
        app:span_count="2"
        app:horizontal_space="@dimen/hxy_large_folder_horizontal_space_4x6"
        app:vertical_space="@dimen/hxy_large_folder_vertical_space_4x6" />

    <com.android.launcher3.OplusBubbleTextView
        android:id="@+id/folder_icon_name"
        style="@style/BaseIcon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_workspace_folder_title_height"
        android:paddingTop="1dp"
        android:layout_gravity="bottom"
        android:focusable="false" />

    <com.android.launcher3.folder.large.listview.HxyLargeFolderPageIndicator
        android:id="@+id/folder_icon_indicator"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/coloros_workspace_folder_title_height"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="invisible"
        android:alpha="0" />
</com.android.launcher3.folder.large.HxyLargeFolderIcon>
