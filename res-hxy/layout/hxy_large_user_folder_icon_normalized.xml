<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors ColorOS oplus_user_folder_icon_normalized.xml structure/dimens. -->
<com.android.launcher3.folder.large.HxyLargeFolder xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- ColorOS folder_header: rename capsule background is set on this view while editing. -->
    <FrameLayout
        android:id="@+id/folder_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_folder_title_height"
        android:layout_marginHorizontal="@dimen/coloros_folder_header_margin_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.android.launcher3.big.ColorEditText
            android:id="@+id/folder_name"
            android:layout_width="@dimen/folder_name_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@null"
            android:fontFamily="google-sans-text"
            android:gravity="center"
            android:hint="@string/folder_hint_text"
            android:imeOptions="flagNoExtractUi"
            android:maxLength="20"
            android:singleLine="true"
            android:textAlignment="center"
            android:textColor="#ffffff"
            android:textColorHighlight="#66FFFFFF"
            android:textColorHint="#B3FFFFFF"
            android:textCursorDrawable="@drawable/folder_name_text_cursor"
            android:textSize="@dimen/folder_label_text_size" />

        <ImageView
            android:id="@+id/clear_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/folder_name_clear_margin_end"
            android:clickable="true"
            android:contentDescription="@string/folder_hint_text"
            android:focusable="true"
            android:scaleType="fitXY"
            android:src="@drawable/folder_name_clear"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ColorOS folder_content_root: page indicator overlays bottom of content. -->
    <FrameLayout
        android:id="@+id/folder_content_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/folder_content_wrapper_margin_top"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.android.launcher3.folder.FolderPagedView
            android:id="@+id/folder_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/folder_pageview_padding_top"
            app:pageIndicator="@+id/folder_page_indicator" />

        <LinearLayout
            android:id="@+id/folder_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/coloros_folder_page_indicator_bottom_space"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

            <com.android.launcher3.pageindicators.PageIndicatorDots
                android:id="@+id/folder_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/coloros_folder_page_indicator_height"
                android:layout_gravity="center"
                android:elevation="1dp" />
        </LinearLayout>
    </FrameLayout>
</com.android.launcher3.folder.large.HxyLargeFolder>
