<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_selectable_card"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/coloros_theme_card_padding">

    <ImageView
        android:id="@+id/theme_preview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_theme_preview_height"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/theme_title"
        android:layout_width="match_parent"
        style="@style/ColorOS.TextAppearance.ThemeTitle"
        android:layout_height="@dimen/coloros_theme_title_height"
        android:breakStrategy="balanced"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="@dimen/coloros_space_micro"
        android:paddingTop="@dimen/coloros_space_small"
        android:paddingEnd="@dimen/coloros_space_micro" />
</LinearLayout>
