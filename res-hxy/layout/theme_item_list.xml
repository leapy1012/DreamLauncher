<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/settings_selectable_card"
    android:padding="@dimen/coloros_theme_card_padding"
    android:layout_margin="@dimen/coloros_space_small">

    <ImageView
        android:id="@+id/theme_preview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_theme_preview_height"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/theme_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_theme_title_height"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/coloros_text_size_theme_title"
        android:textColor="@color/coloros_text_primary" />
</LinearLayout>
