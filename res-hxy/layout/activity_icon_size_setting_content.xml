<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/coloros_page_horizontal_padding"
    android:paddingEnd="@dimen/coloros_page_horizontal_padding"
    android:paddingBottom="@dimen/coloros_page_bottom_padding">

    <!-- Wallpaper-blur preview host (Oppo Icons style). -->
    <FrameLayout
        android:id="@+id/icon_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/icon_preview_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hxy_icon_size_rv_shape"
            android:scaleType="centerCrop" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iconsizeRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingTop="15dp"
            android:paddingBottom="15dp" />
    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coloros_space_large"
        android:paddingStart="@dimen/coloros_card_content_padding"
        android:paddingEnd="@dimen/coloros_card_content_padding">

        <TextView
            android:id="@+id/icon_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/home_screen_icon_size"
            android:textColor="?attr/couiColorLabelPrimary"
            android:textSize="16sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif"
            android:textFontWeight="400" />

        <!-- Oppo ux_seekbar_layout: Default label vs Restore action. -->
        <FrameLayout
            android:id="@+id/icon_size_value_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:minWidth="56dp">

            <TextView
                android:id="@+id/icon_size_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/icon_size_restore_description"
                android:focusable="true"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/icon_size_restore"
                android:textColor="?attr/couiColorPrimary"
                android:textSize="14sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif"
                android:textFontWeight="400" />

            <TextView
                android:id="@+id/icon_size_default_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/icon_size_default"
                android:textColor="?attr/couiColorLabelSecondary"
                android:textSize="14sp"
                android:textStyle="normal"
                android:visibility="gone"
                android:fontFamily="sans-serif"
                android:textFontWeight="400" />
        </FrameLayout>
    </RelativeLayout>

    <com.coui.appcompat.seekbar.COUISeekBar
        android:id="@+id/icon_size_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coloros_space_small"
        android:paddingStart="@dimen/coloros_card_content_padding"
        android:paddingEnd="@dimen/coloros_card_content_padding" />

    <TextView
        android:id="@+id/icon_shape_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coloros_space_large"
        android:layout_marginStart="@dimen/coloros_card_content_padding"
        android:layout_marginEnd="@dimen/coloros_card_content_padding"
        android:text="@string/home_screen_icon_shape"
        android:textColor="?attr/couiColorLabelPrimary"
        android:textSize="16sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif"
        android:textFontWeight="400" />

    <com.android.launcher3.views.RadioGroupLinearLayout
        android:id="@+id/radioIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/coloros_space_small"
        android:layout_marginStart="@dimen/coloros_card_content_padding"
        android:layout_marginEnd="@dimen/coloros_card_content_padding"
        android:background="@drawable/hxy_icon_style_rv_shape"
        android:orientation="horizontal"
        android:padding="10dp" />

    <com.coui.appcompat.button.COUILoadingButton
        android:id="@+id/applyTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/coloros_space_small"
        android:layout_marginEnd="@dimen/coloros_space_small"
        android:layout_marginTop="@dimen/coloros_space_xxlarge"
        android:minHeight="@dimen/coui_btn_large_height_min"
        android:text="@string/apply"
        app:isShowLoadingText="true"
        app:loadingText="@string/layout_being_applied"
        style="?attr/couiButtonColorfulDefaultStyle" />

    <!-- Extra space so COUI list can scroll and show toolbar divider. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/coloros_icon_custom_scroll_extra" />
</LinearLayout>
