<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coloros_surface_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/coloros_page_horizontal_padding"
        android:paddingTop="@dimen/coloros_page_top_padding"
        android:paddingEnd="@dimen/coloros_page_horizontal_padding"
        android:paddingBottom="@dimen/coloros_page_bottom_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ColorOS.TextAppearance.SectionLabel"
            android:layout_marginStart="@dimen/coloros_section_label_inset"
            android:layout_marginBottom="@dimen/coloros_space_small"
            android:text="@string/home_screen_icon_size"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:orientation="vertical"
            android:paddingTop="@dimen/coloros_card_content_padding"
            android:paddingBottom="@dimen/coloros_icon_card_bottom_padding">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/iconsizeRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/coloros_space_small"
                android:paddingEnd="@dimen/coloros_space_small"
                android:paddingTop="@dimen/coloros_space_small" />

            <com.coui.appcompat.seekbar.COUISectionSeekBar
                android:id="@+id/demo_5_seek_bar_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/coloros_control_height"
                android:layout_marginTop="@dimen/coloros_space_medium"
                android:layout_marginStart="@dimen/coloros_space_xlarge"
                android:layout_marginEnd="@dimen/coloros_space_xlarge"
                android:max="4"
                android:min="0"
                app:couiSeekBarEnableVibrator="true"
                app:couiSeekBarShowGlitterEffect="true"
                app:couiSeekBarShowProgress="true"
                app:couiSeekBarShowThumb="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/coloros_space_xlarge"
                android:layout_marginEnd="@dimen/coloros_space_xlarge"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="XS"
                    style="@style/ColorOS.TextAppearance.Caption" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="S"
                    style="@style/ColorOS.TextAppearance.Caption" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="M"
                    style="@style/ColorOS.TextAppearance.Caption" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="L"
                    style="@style/ColorOS.TextAppearance.Caption" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="XL"
                    style="@style/ColorOS.TextAppearance.Caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ColorOS.TextAppearance.SectionLabel"
            android:layout_marginStart="@dimen/coloros_section_label_inset"
            android:layout_marginTop="@dimen/coloros_section_gap"
            android:layout_marginBottom="@dimen/coloros_space_small"
            android:text="@string/home_screen_icon_shape"
            />

        <com.android.launcher3.views.RadioGroupLinearLayout
            android:id="@+id/radioIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_card"
            android:orientation="horizontal"
            android:paddingStart="@dimen/coloros_space_small"
            android:paddingTop="@dimen/coloros_card_content_padding"
            android:paddingEnd="@dimen/coloros_space_small"
            android:paddingBottom="@dimen/coloros_card_content_padding" />

        <com.coui.appcompat.button.COUIButton
            android:id="@+id/applyTv"
            style="@style/ColorOS.Widget.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/coloros_action_height"
            android:layout_marginStart="@dimen/coloros_space_small"
            android:layout_marginTop="@dimen/coloros_space_xxlarge"
            android:layout_marginEnd="@dimen/coloros_space_small"
            android:text="@android:string/ok"
            />
    </LinearLayout>
</ScrollView>
