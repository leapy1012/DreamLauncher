<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="@string/home_screen_icon_size"
            android:textColor="?android:attr/textColorPrimary" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iconsizeRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/hxy_icon_size_rv_shape"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="15dp" />

        <com.android.launcher3.customer.seekbar.SignSeekBar
            android:id="@+id/demo_5_seek_bar_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/density_30dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:ssb_anim_duration="300"
            app:ssb_auto_adjust_section_mark="false"
            app:ssb_second_track_color="@color/home_settings_header_accent"
            app:ssb_second_track_size="28dp"
            app:ssb_section_text_color="@color/text_color_tertiary_dark"
            app:ssb_section_text_size="15sp"
            app:ssb_show_section_mark="true"
            app:ssb_show_section_text="true"
            app:ssb_show_thumb_shadow="false"
            app:ssb_show_thumb_text="false"
            app:ssb_sides_labels="@array/labels"
            app:ssb_text_space="20dp"
            app:ssb_thumb_color="@color/home_settings_header_accent"
            app:ssb_thumb_radius="14dp"
            app:ssb_thumb_radius_on_dragging="0dp"
            app:ssb_thumb_text_size="16sp"
            app:ssb_touch_to_seek="true"
            app:ssb_track_color="#b4b4b4"
            app:ssb_track_size="28dp"
            app:ssb_unusable_color="#585858" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="@string/home_screen_icon_shape"
            android:textColor="?android:attr/textColorPrimary" />

        <com.android.launcher3.views.RadioGroupLinearLayout
            android:id="@+id/radioIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/hxy_icon_style_rv_shape"
            android:orientation="horizontal"
            android:padding="10dp" />

        <TextView
            android:id="@+id/applyTv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/density_45dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/custom_icon_size_apply_bg"
            android:gravity="center"
            android:text="@android:string/ok"
            android:textColor="#fff"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>