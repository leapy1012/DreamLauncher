<?xml version="1.0" encoding="utf-8"?>
<com.android.quickstep.views.TaskView xmlns:androidprv="http://schemas.android.com/apk/prv/res/android"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:defaultFocusHighlightEnabled="false">
    <com.android.quickstep.views.TaskThumbnailView
        android:id="@+id/snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/hxy_task_thumbnail_top_margin"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/hxy_taskview_menu_control"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hxy_task_menu_height"
        android:layout_marginTop="@dimen/hxy_task_menu_top_margin"
        android:layout_above="@+id/snapshot">
        <com.android.quickstep.views.IconView
            android:id="@+id/icon"
            android:focusable="false"
            android:layout_width="@dimen/hxy_task_thumbnail_icon_size"
            android:layout_height="@dimen/hxy_task_thumbnail_icon_size"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/hxy_task_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:maxWidth="160dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_toEndOf="@+id/icon"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/hxy_task_menu"
            android:layout_width="@dimen/hxy_task_menu_icon_size"
            android:layout_height="@dimen/hxy_task_menu_icon_size"
            android:layout_marginEnd="5dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:scaleType="center"
            android:src="@drawable/ic_task_menu"
            android:tint="#ffffff"/>
    </RelativeLayout>
</com.android.quickstep.views.TaskView>
