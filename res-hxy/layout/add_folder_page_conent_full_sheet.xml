<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.big.add.AddFolderItemToolFullSheet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/add_contain_folder_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="5dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="@dimen/density_30dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancel_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/density_20dp"
                android:gravity="center"
                android:text="@android:string/cancel"
                android:textColor="#ffffffff"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/complete_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/density_20dp"
                android:gravity="center"
                android:text="@android:string/ok"
                android:textColor="#ffffffff"
                android:textSize="14dp" />
        </RelativeLayout>

        <com.android.launcher3.big.add.HxyContentPagedView
            android:id="@+id/add_folder_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            app:pageIndicator="@+id/add_folder_page_indicator" />

        <LinearLayout
            android:id="@+id/folder_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <com.android.launcher3.pageindicators.PageIndicatorDots
                android:id="@+id/add_folder_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.android.launcher3.big.add.AddFolderItemToolFullSheet>