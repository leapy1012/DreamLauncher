  <favorite screen="1" x="2" y="0" packageName="com.android.soundrecorder" className="com.android.soundrecorder.SoundRecorder"/>
  <favorite screen="1" x="3" y="0" packageName="com.google.android.calculator" className="com.android.calculator2.Calculator"/>
  <favorite screen="1" x="0" y="1" packageName="com.google.android.calendar" className="com.android.calendar.AllInOneActivity"/>
  <favorite screen="1" x="1" y="1" packageName="com.google.android.contacts" className="com.android.contacts.activities.PeopleActivity"/>  
  <favorite screen="1" x="2" y="1" packageName="com.google.android.deskclock" className="com.android.deskclock.DeskClock"/>
