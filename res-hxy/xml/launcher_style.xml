<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/home_screen_style_title">

    <com.coui.appcompat.preference.COUIPreferenceCategory
        android:key="home_screen_mode_category"
        android:persistent="false">
        <com.android.launcher3.settings.HomeScreenModePreference
            android:key="home_screen_mode"
            android:persistent="false" />
    </com.coui.appcompat.preference.COUIPreferenceCategory>

    <com.coui.appcompat.preference.COUIPreferenceCategory
        android:key="home_screen_drawer_settings"
        android:persistent="false">

        <com.coui.appcompat.preference.COUISwitchPreference
            android:key="add_app_to_launcher"
            android:persistent="false"
            android:title="@string/coloros_add_app_to_home" />

        <com.coui.appcompat.preference.COUISwitchPreference
            android:key="launcher_is_show_indicated_app"
            android:persistent="false"
            android:title="@string/coloros_show_app_suggestions" />

        <com.coui.appcompat.preference.COUIMenuPreference
            android:key="key_drawer_default_page"
            android:persistent="false"
            android:title="@string/coloros_drawer_default_view"
            android:entries="@array/coloros_drawer_default_view_entries"
            android:entryValues="@array/coloros_drawer_default_view_values" />

        <com.coui.appcompat.preference.COUIMenuPreference
            android:key="key_drawer_column_switch"
            android:persistent="false"
            android:title="@string/coloros_drawer_layout"
            android:entries="@array/coloros_drawer_layout_entries"
            android:entryValues="@array/coloros_drawer_layout_values" />

        <com.coui.appcompat.preference.COUISwitchPreference
            android:key="key_drawer_show_app_name"
            android:persistent="false"
            android:title="@string/coloros_drawer_show_app_names" />
    </com.coui.appcompat.preference.COUIPreferenceCategory>
</androidx.preference.PreferenceScreen>
